// Lencería Lizzy - Modelo relacional (MySQL 8, base ropainterior_db)
// Pegar en https://dbdiagram.io/d  -> Export -> PNG o PDF
// Generado a partir de information_schema de la base real (16 tablas).

Table auth_user {
  id int [pk, increment]
  password varchar(128) [not null, note: 'Hash de la contraseña']
  last_login datetime
  is_superuser tinyint [not null]
  username varchar(150) [unique, not null]
  first_name varchar(150) [not null]
  last_name varchar(150) [not null]
  email varchar(254) [not null]
  is_staff tinyint [not null, note: '1 = vendedora o administradora']
  is_active tinyint [not null]
  date_joined datetime [not null]
}

Table catalogo_categoria {
  id bigint [pk, increment]
  nombre varchar(50) [unique, not null]
  orden smallint [not null]
}

Table catalogo_subcategoria {
  id bigint [pk, increment]
  categoria_id bigint [not null]
  nombre varchar(50) [not null]
  tipo_talla varchar(10) [not null, note: 'letra, brassiere o sin_talla']

  indexes {
    (categoria_id, nombre) [unique]
  }
}

Table catalogo_producto {
  id bigint [pk, increment]
  categoria_id bigint [not null]
  subcategoria_id bigint [not null]
  nombre varchar(150) [not null]
  descripcion longtext [not null]
  precio decimal(8,2) [not null]
  activo tinyint [not null, note: 'Baja logica, no se borra']
  en_oferta tinyint [not null]
  porcentaje_descuento smallint [not null, note: '0 a 90']
  temporada varchar(15) [not null, note: 'todo_el_anio, invierno o verano']
  creado datetime [not null]
  actualizado datetime [not null]
}

Table catalogo_varianteproducto {
  id bigint [pk, increment]
  producto_id bigint [not null]
  talla varchar(10) [not null]
  color varchar(50) [not null, note: 'Vacio si no maneja color']
  stock int [not null]
}

Table catalogo_imagenproducto {
  id bigint [pk, increment]
  producto_id bigint [not null]
  imagen varchar(100) [not null, note: 'Ruta del archivo']
  orden smallint [not null]
  es_portada tinyint [not null]
}

Table catalogo_configuracionnegocio {
  id bigint [pk, increment]
  nombre_negocio varchar(100) [not null]
  whatsapp_numero varchar(20) [not null]
  banco_nombre varchar(100) [not null]
  banco_titular varchar(100) [not null]
  banco_numero_cuenta varchar(50) [not null]
  qr_pago varchar(100)
  direccion_local varchar(255) [not null]
  foto_local varchar(100)
  mapa_url varchar(200) [not null]
  actualizado datetime [not null]
  Note: 'Un solo registro con los datos del negocio'
}

Table clientas_perfilcliente {
  id bigint [pk, increment]
  usuario_id int [unique, not null]
  telefono varchar(20) [not null]
  genero varchar(10) [not null, note: 'mujer, hombre u otro']
  talla_brassiere varchar(5) [not null]
  talla_calzon varchar(5) [not null]
  creado datetime [not null]
  actualizado datetime [not null]
}

Table clientas_direccionentrega {
  id bigint [pk, increment]
  usuario_id int [not null]
  nombre_referencia varchar(50) [not null]
  calle varchar(200) [not null]
  barrio varchar(100) [not null]
  referencias longtext [not null]
  es_predeterminada tinyint [not null]
  creado datetime [not null]
}

Table clientas_favorito {
  id bigint [pk, increment]
  usuario_id int [not null]
  producto_id bigint [not null]
  creado datetime [not null]

  indexes {
    (usuario_id, producto_id) [unique]
  }
}

Table clientas_carritoguardado {
  id bigint [pk, increment]
  usuario_id int [unique, not null]
  datos json [not null, note: 'Lineas del carrito']
  actualizado datetime [not null]
}

Table pedidos_pedido {
  id bigint [pk, increment]
  clienta_id int [not null]
  direccion_id bigint
  tipo_entrega varchar(15) [not null, note: 'recogida o tienda']
  fecha_venta datetime [not null]
  lugar_venta varchar(20) [not null, note: 'online, mercado_lourdes o feria_barrio_nuevo']
  origen varchar(10) [not null, note: 'real, estimado o prueba']
  nota varchar(300) [not null]
  estado varchar(20) [not null, note: 'en_verificacion, confirmado, preparacion, entregado, cancelado']
  fecha_estimada_entrega date
  notificacion_entrega_pendiente tinyint [not null]
  total decimal(10,2) [not null]
  creado datetime [not null]
  actualizado datetime [not null]
}

Table pedidos_itempedido {
  id bigint [pk, increment]
  pedido_id bigint [not null]
  producto_id bigint [not null]
  talla varchar(10) [not null]
  color varchar(50) [not null]
  cantidad int [not null]
  precio_unitario decimal(8,2) [not null, note: 'Precio cobrado']
}

Table pedidos_pago {
  id bigint [pk, increment]
  pedido_id bigint [unique, not null]
  metodo varchar(15) [not null, note: 'qr, efectivo o whatsapp']
  estado varchar(15) [not null, note: 'pendiente, verificado o rechazado']
  comprobante varchar(100)
  nombre_referencia varchar(100) [not null]
  creado datetime [not null]
  actualizado datetime [not null]
}

Table chat_mensaje {
  id bigint [pk, increment]
  usuario_id int [not null, note: 'Clienta duena de la conversacion']
  emisor varchar(10) [not null, note: 'clienta o vendedora']
  texto varchar(1000) [not null]
  imagen varchar(100)
  video varchar(100)
  automatico tinyint [not null]
  leido tinyint [not null]
  creado datetime [not null]
}

Table chat_imagenmensaje {
  id bigint [pk, increment]
  mensaje_id bigint [not null]
  imagen varchar(100) [not null]
  video varchar(100)
}

// ---------- Relaciones (clave foránea > clave primaria) ----------
Ref: catalogo_subcategoria.categoria_id > catalogo_categoria.id
Ref: catalogo_producto.categoria_id > catalogo_categoria.id
Ref: catalogo_producto.subcategoria_id > catalogo_subcategoria.id
Ref: catalogo_varianteproducto.producto_id > catalogo_producto.id
Ref: catalogo_imagenproducto.producto_id > catalogo_producto.id

Ref: clientas_perfilcliente.usuario_id - auth_user.id
Ref: clientas_carritoguardado.usuario_id - auth_user.id
Ref: clientas_direccionentrega.usuario_id > auth_user.id
Ref: clientas_favorito.usuario_id > auth_user.id
Ref: clientas_favorito.producto_id > catalogo_producto.id

Ref: pedidos_pedido.clienta_id > auth_user.id
Ref: pedidos_pedido.direccion_id > clientas_direccionentrega.id
Ref: pedidos_itempedido.pedido_id > pedidos_pedido.id
Ref: pedidos_itempedido.producto_id > catalogo_producto.id
Ref: pedidos_pago.pedido_id - pedidos_pedido.id

Ref: chat_mensaje.usuario_id > auth_user.id
Ref: chat_imagenmensaje.mensaje_id > chat_mensaje.id
